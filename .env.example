# Copy this file to .env and fill in your values. Never commit .env to GitHub.

# ---- AI provider: pick ONE ----
# Free: Google Gemini key from https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Free (no embeddings, search uses keywords): Groq key from https://console.groq.com/keys
# LLM_PROVIDER=groq
# GROQ_API_KEY=

# Paid: OpenAI key from https://platform.openai.com/api-keys
# LLM_PROVIDER=openai
# OPENAI_API_KEY=

# Optional: force a specific model. If it isn't available, Scrap Saver tries other models automatically.
# LLM_MODEL=

# ---- Gmail (optional) ----
# Your address + a 16-character App password
# (Google Account > Security > 2-Step Verification > App passwords). Not your normal password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# How many recent payment emails to read per sync, and how far back (days)
PAYTRAIL_MAX_EMAILS=60
PAYTRAIL_LOOKBACK_DAYS=365
